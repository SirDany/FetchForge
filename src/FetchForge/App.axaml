<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FetchForge.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme/>
        <Style Selector="Window">
            <Setter Property="Background" Value="#111318"/>
            <Setter Property="Foreground" Value="#E7E9EE"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="11,6"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#991B1B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.subtle">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#191C23"/>
            <Setter Property="BorderBrush" Value="#2C303A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#14171D"/>
            <Setter Property="BorderBrush" Value="#262A34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9CA3B2"/>
        </Style>
    </Application.Styles>
</Application>
