<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FetchForge.MainWindow" Title="FetchForge" Width="1100" Height="780" MinWidth="850" MinHeight="650">
    <Grid RowDefinitions="Auto,*" Margin="20" RowSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="FetchForge" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Media downloads and audio processing" Classes="muted"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="1.1*,0.9*" ColumnSpacing="16">
            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="16">
                    <Border Classes="panel">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Download" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Video or playlist URL" Classes="muted"/>
                            <TextBox x:Name="UrlBox" Watermark="Paste URL here"/>
                            <TextBlock Text="Output directory" Classes="muted"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox x:Name="OutputBox"/>
                                <Button Grid.Column="1" Content="Browse" Click="BrowseOutput_Click"/>
                            </Grid>
                            <CheckBox x:Name="PlaylistOrderCheck" Content="Preserve playlist order in filenames" IsChecked="True"/>
                            <Button Content="Check dependencies" Click="CheckTools_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Audio processing" FontSize="18" FontWeight="SemiBold"/>
                            <CheckBox x:Name="EnhanceCheck" Content="Enable FFmpeg processing" IsChecked="True"/>
                            <TextBlock Text="FFmpeg audio filter chain" Classes="muted"/>
                            <TextBox x:Name="FilterBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" VerticalContentAlignment="Top"/>
                            <TextBlock Text="Maximum concurrent FFmpeg jobs" Classes="muted"/>
                            <NumericUpDown x:Name="ConcurrencyBox" Minimum="1" Maximum="64" Value="16"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Import profile" Click="ImportProfile_Click"/>
                                <Button Content="Export profile" Click="ExportProfile_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Advanced arguments" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="yt-dlp — one argument per line" Classes="muted"/>
                            <TextBox x:Name="YtDlpArgsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalContentAlignment="Top"/>
                            <TextBlock Text="FFmpeg — one argument per line" Classes="muted"/>
                            <TextBox x:Name="FfmpegArgsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Text="Activity and process report" FontSize="18" FontWeight="SemiBold"/>
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="400"/>
                    <TextBlock Text="The download queue and FFmpeg processing pipeline are not implemented yet." Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>